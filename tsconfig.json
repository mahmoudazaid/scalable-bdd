{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node16",
    "types": ["node"]
  },
  "include": ["features/**/*", "src/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "test-results", ".features-gen", "playwright-report", "cucumber-report"]
}
